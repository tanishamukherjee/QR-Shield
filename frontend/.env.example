# QRShield Frontend Configuration
# Replace with your deployed AWS Lambda Function URL or local dev server:
# E.g. for AWS Lambda Function URL:
# VITE_API_BASE_URL=https://<your-lambda-url-id>.lambda-url.<region>.on.aws/
# E.g. for Local Python Server:
# VITE_API_BASE_URL=http://127.0.0.1:8000

VITE_API_BASE_URL=http://127.0.0.1:8000

# When set to true, forces frontend mock engine for offline evaluation without any backend running
VITE_ENABLE_OFFLINE_MOCK=false
